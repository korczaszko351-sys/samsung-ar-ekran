# Build artifacts and dependencies
node_modules/
dist/
.expo/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` — never commit them
/android
/ios

# The icon is generated by scripts/make-icon.mjs (postinstall)
assets/images/icon.png

# Signing material — NEVER commit a keystore
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Local environment
.env
.env*.local

# Logs and caches
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
.metro-health-check*
.gradle/

# OS noise
.DS_Store
Thumbs.db
