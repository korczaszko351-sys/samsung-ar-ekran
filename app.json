{
  "expo": {
    "name": "Samsung AR Ekran",
    "slug": "samsung-ar-ekran",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "samsungarekan",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E1016",
    "ios": {
      "bundleIdentifier": "com.korczaszko.samsungarekan",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Aplikacja używa aparatu jako tła, na którym rysowany jest obraz projekcji.",
        "NSMotionUsageDescription": "Czujnik ruchu pozwala utrzymać obraz na zaznaczonej powierzchni podczas obracania telefonu."
      }
    },
    "android": {
      "package": "com.korczaszko.samsungarekan",
      "versionCode": 2,
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1016",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja używa aparatu jako tła dla obrazu projekcji.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wybierz obraz z galerii, który ma być wyświetlany na powierzchni."
        }
      ],
      "./plugins/with-camera-compatible-preview"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
